# ---------------------------------------------------------------------------
# The keys of TOOLTDH.
#
# Copy this file to ".env" and put the real keys in it. The ".env" file
# never goes on GitHub: it is in the .gitignore.
#
# The local analyzers do not need any key. They work on the machine, with
# the frames and the sound of the videos. A key is only needed by the
# parts that reach a paid service.
# ---------------------------------------------------------------------------

# The key of Gemini. It is only used by the parts that are not the local
# analyzer. Leave it empty to stay fully local.
GEMINI_API_KEY=

# The key of the Meta platform. It is used to read the numbers of the
# posts. Leave it empty to skip that.
META_API_KEY=

# The key of OpenAI. It is only used by the parts that are not the local
# analyzer. Leave it empty to stay fully local.
OPENAI_API_KEY=
